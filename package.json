{
  "name": "otools-screendraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone OTools plugin: fullscreen transparent annotation overlay with pen, highlighter, shapes, laser pointer, click-through and whiteboard mode.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6553",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@excalidraw/laser-pointer": "^1.3.2",
    "@tauri-apps/api": "^2.9.4",
    "otools-plugin-sdk": "^0.3.0",
    "perfect-freehand": "^1.2.3",
    "vue": "3.5.27"
  },
  "devDependencies": {
    "@lucide/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-vue": "5.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  }
}
